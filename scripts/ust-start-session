#!/usr/bin/env bash
# Session entrypoint for "Ubuntu Studio Tablet"
set -euo pipefail

export XDG_CURRENT_DESKTOP="${XDG_CURRENT_DESKTOP:-KDE}"
export XDG_SESSION_TYPE="${XDG_SESSION_TYPE:-wayland}"
export GTK_IM_MODULE=fcitx5
export QT_IM_MODULE=fcitx5
export XMODIFIERS=@im=fcitx5
export QT_QUICK_CONTROLS_MOBILE=1
export PLASMA_USE_QT_SCALING=1

# Tablet-oriented Plasma
export KDE_FULL_SESSION=true

MODE="wayland"
if [[ "${1:-}" == "--x11" ]]; then
  MODE="x11"
fi

# Ensure user configs exist (first login after install)
if [[ -n "${HOME:-}" && -d /etc/skel/.config ]]; then
  mkdir -p "$HOME/.config"
  for f in kwinrc kwinrulesrc plasmarc kdeglobals kcminputrc kxkbrc; do
    if [[ ! -f "$HOME/.config/$f" && -f "/etc/skel/.config/$f" ]]; then
      cp "/etc/skel/.config/$f" "$HOME/.config/$f"
    fi
  done
fi

if [[ "$MODE" == "x11" ]]; then
  exec /usr/bin/startplasma-x11
else
  if [[ -x /usr/bin/startplasma-wayland ]]; then
    exec /usr/bin/startplasma-wayland
  else
    exec /usr/bin/startplasma-x11
  fi
fi
