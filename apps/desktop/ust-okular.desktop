[Desktop Entry]
Version=1.0
Type=Application
Name=Okular
Name[zh_CN]=文档阅读
GenericName=Tablet App
GenericName[zh_CN]=平板应用
Comment=Ubuntu Studio Tablet fullscreen app
Comment[zh_CN]=Ubuntu Studio 平板全屏应用
Exec=/usr/lib/ubuntu-studio-tablet/bin/ust-launch --class org.kde.okular -- okular
Icon=okular
Terminal=false
StartupNotify=true
StartupWMClass=org.kde.okular
Categories=UbuntuStudioTablet;Office;Viewer;
Keywords=studio;tablet;touch;Okular;
X-Ubuntu-Studio-Tablet=true
X-KDE-FormFactor=tablet;handset;desktop;
