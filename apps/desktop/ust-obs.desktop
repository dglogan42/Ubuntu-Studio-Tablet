[Desktop Entry]
Version=1.0
Type=Application
Name=OBS Studio
Name[zh_CN]=OBS 直播推流
GenericName=Tablet App
GenericName[zh_CN]=平板应用
Comment=Ubuntu Studio Tablet fullscreen app
Comment[zh_CN]=Ubuntu Studio 平板全屏应用
Exec=/usr/lib/ubuntu-studio-tablet/bin/ust-launch --class obs -- obs
Icon=com.obsproject.Studio
Terminal=false
StartupNotify=true
StartupWMClass=obs
Categories=UbuntuStudioTablet;AudioVideo;Video;
Keywords=studio;tablet;touch;OBS Studio;
X-Ubuntu-Studio-Tablet=true
X-KDE-FormFactor=tablet;handset;desktop;
