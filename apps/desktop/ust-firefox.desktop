[Desktop Entry]
Version=1.0
Type=Application
Name=Browser
Name[zh_CN]=浏览器
GenericName=Tablet App
GenericName[zh_CN]=平板应用
Comment=Ubuntu Studio Tablet fullscreen app
Comment[zh_CN]=Ubuntu Studio 平板全屏应用
Exec=/usr/lib/ubuntu-studio-tablet/bin/ust-launch --class Navigator -- firefox
Icon=firefox
Terminal=false
StartupNotify=true
StartupWMClass=Navigator
Categories=UbuntuStudioTablet;Network;WebBrowser;
Keywords=studio;tablet;touch;Browser;
X-Ubuntu-Studio-Tablet=true
X-KDE-FormFactor=tablet;handset;desktop;
