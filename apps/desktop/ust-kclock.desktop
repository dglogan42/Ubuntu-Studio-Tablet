[Desktop Entry]
Version=1.0
Type=Application
Name=Clock
Name[zh_CN]=时钟
GenericName=Tablet App
GenericName[zh_CN]=平板应用
Comment=Ubuntu Studio Tablet fullscreen app
Comment[zh_CN]=Ubuntu Studio 平板全屏应用
Exec=/usr/lib/ubuntu-studio-tablet/bin/ust-launch --class org.kde.kclock -- kclock
Icon=preferences-system-time
Terminal=false
StartupNotify=true
StartupWMClass=org.kde.kclock
Categories=UbuntuStudioTablet;Utility;
Keywords=studio;tablet;touch;Clock;
X-Ubuntu-Studio-Tablet=true
X-KDE-FormFactor=tablet;handset;desktop;
