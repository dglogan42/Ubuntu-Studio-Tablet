[Desktop Entry]
Version=1.0
Type=Application
Name=Audacity
Name[zh_CN]=Audacity 录音编辑
GenericName=Tablet App
GenericName[zh_CN]=平板应用
Comment=Ubuntu Studio Tablet fullscreen app
Comment[zh_CN]=Ubuntu Studio 平板全屏应用
Exec=/usr/lib/ubuntu-studio-tablet/bin/ust-launch --class Audacity -- audacity
Icon=audacity
Terminal=false
StartupNotify=true
StartupWMClass=Audacity
Categories=UbuntuStudioTablet;AudioVideo;Audio;
Keywords=studio;tablet;touch;Audacity;
X-Ubuntu-Studio-Tablet=true
X-KDE-FormFactor=tablet;handset;desktop;
