[Desktop Entry]
Version=1.0
Type=Application
Name=Terminal
Name[zh_CN]=终端
GenericName=Tablet App
GenericName[zh_CN]=平板应用
Comment=Ubuntu Studio Tablet fullscreen app
Comment[zh_CN]=Ubuntu Studio 平板全屏应用
Exec=/usr/lib/ubuntu-studio-tablet/bin/ust-launch --class konsole -- konsole
Icon=utilities-terminal
Terminal=false
StartupNotify=true
StartupWMClass=konsole
Categories=UbuntuStudioTablet;System;TerminalEmulator;
Keywords=studio;tablet;touch;Terminal;
X-Ubuntu-Studio-Tablet=true
X-KDE-FormFactor=tablet;handset;desktop;
