[Desktop Entry]
Version=1.0
Type=Application
Name=Blender
Name[zh_CN]=Blender 3D
GenericName=Tablet App
GenericName[zh_CN]=平板应用
Comment=Ubuntu Studio Tablet fullscreen app
Comment[zh_CN]=Ubuntu Studio 平板全屏应用
Exec=/usr/lib/ubuntu-studio-tablet/bin/ust-launch --class Blender -- blender
Icon=blender
Terminal=false
StartupNotify=true
StartupWMClass=Blender
Categories=UbuntuStudioTablet;Graphics;3DGraphics;
Keywords=studio;tablet;touch;Blender;
X-Ubuntu-Studio-Tablet=true
X-KDE-FormFactor=tablet;handset;desktop;
