[Desktop Entry]
Version=1.0
Type=Application
Name=Ardour
Name[zh_CN]=Ardour 数字音频工作站
GenericName=Tablet App
GenericName[zh_CN]=平板应用
Comment=Ubuntu Studio Tablet fullscreen app
Comment[zh_CN]=Ubuntu Studio 平板全屏应用
Exec=/usr/lib/ubuntu-studio-tablet/bin/ust-launch --class Ardour -- ardour
Icon=ardour
Terminal=false
StartupNotify=true
StartupWMClass=Ardour
Categories=UbuntuStudioTablet;AudioVideo;Audio;
Keywords=studio;tablet;touch;Ardour;
X-Ubuntu-Studio-Tablet=true
X-KDE-FormFactor=tablet;handset;desktop;
