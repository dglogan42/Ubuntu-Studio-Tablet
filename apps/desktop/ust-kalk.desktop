[Desktop Entry]
Version=1.0
Type=Application
Name=Calculator
Name[zh_CN]=计算器
GenericName=Tablet App
GenericName[zh_CN]=平板应用
Comment=Ubuntu Studio Tablet fullscreen app
Comment[zh_CN]=Ubuntu Studio 平板全屏应用
Exec=/usr/lib/ubuntu-studio-tablet/bin/ust-launch --class org.kde.kalk -- kalk
Icon=accessories-calculator
Terminal=false
StartupNotify=true
StartupWMClass=org.kde.kalk
Categories=UbuntuStudioTablet;Utility;
Keywords=studio;tablet;touch;Calculator;
X-Ubuntu-Studio-Tablet=true
X-KDE-FormFactor=tablet;handset;desktop;
