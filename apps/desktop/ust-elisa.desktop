[Desktop Entry]
Version=1.0
Type=Application
Name=Elisa
Name[zh_CN]=音乐
GenericName=Tablet App
GenericName[zh_CN]=平板应用
Comment=Ubuntu Studio Tablet fullscreen app
Comment[zh_CN]=Ubuntu Studio 平板全屏应用
Exec=/usr/lib/ubuntu-studio-tablet/bin/ust-launch --class org.kde.elisa -- elisa
Icon=elisa
Terminal=false
StartupNotify=true
StartupWMClass=org.kde.elisa
Categories=UbuntuStudioTablet;AudioVideo;Player;
Keywords=studio;tablet;touch;Elisa;
X-Ubuntu-Studio-Tablet=true
X-KDE-FormFactor=tablet;handset;desktop;
