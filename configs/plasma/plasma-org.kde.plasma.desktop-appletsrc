# Tablet home: full-width bottom panel + desktop with app launcher emphasis
# Applied via install script into ~/.config/

[ActionPlugins][0]
MiddleButton;NoModifier=org.kde.paste
RightButton;NoModifier=org.kde.contextmenu

[Containments][1]
activityId=
formfactor=0
immutability=1
lastScreen=0
location=4
plugin=org.kde.panel
wallpaperplugin=org.kde.image

[Containments][1][Applets][2]
immutability=1
plugin=org.kde.plasma.kickerdash

[Containments][1][Applets][2][Configuration][General]
useExtraRunners=true
alphaSort=true
showAppsByName=true

[Containments][1][Applets][3]
immutability=1
plugin=org.kde.plasma.pager

[Containments][1][Applets][4]
immutability=1
plugin=org.kde.plasma.icontasks

[Containments][1][Applets][4][Configuration][General]
launchers=applications:ust-krita.desktop,applications:ust-ardour.desktop,applications:ust-kdenlive.desktop,applications:ust-firefox.desktop,applications:ust-systemsettings.desktop
showOnlyCurrentDesktop=true
showOnlyCurrentScreen=false
maxStripes=1
forceStripes=false
iconSpacing=8

[Containments][1][Applets][5]
immutability=1
plugin=org.kde.plasma.marginsseparator

[Containments][1][Applets][6]
immutability=1
plugin=org.kde.plasma.systemtray

[Containments][1][Applets][7]
immutability=1
plugin=org.kde.plasma.digitalclock

[Containments][1][General]
AppletOrder=2;3;4;5;6;7

[Containments][1][ConfigDialog]
DialogHeight=84
DialogWidth=1200

[Containments][8]
activityId=DEFAULT_ACTIVITY
formfactor=0
immutability=1
lastScreen=0
location=0
plugin=org.kde.plasma.folder
wallpaperplugin=org.kde.image

[Containments][8][Wallpaper][org.kde.image][General]
Image=file:///usr/share/ubuntu-studio-tablet/wallpapers/studio-tablet-dark.png
